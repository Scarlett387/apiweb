{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diy-nav",
  "main": "apps/api/dist/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  // 修复：仓库里同时存在 pino@9 与 pino@10，Workers 打包时双实例互不兼容
  // （fastify 的 logger-pino 读 pino.symbols 报 undefined）。统一钉到单文件解决。
  "alias": {
    "pino": "./node_modules/.pnpm/pino@10.1.0/node_modules/pino/pino.js"
  },
  // 前端静态资源：直接由 Cloudflare 边缘托管，未匹配到文件的请求（/api/* 等）进入 Worker
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application"
  },
  "account_id": "be6085bd4a0ac994d0b64de4fbe57512",
  // D1 数据库原生绑定：绑定到账号里的 apiweb-d1
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apiweb-d1",
      "database_id": "646fa7fa-b9aa-4641-83cb-edb5be462935"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    // 首次部署引导用；随后会转存为加密 Secret 并从本文件移除（勿提交真实密钥到公开仓库）
    "JWT_SECRET": "f0dac1e7b641065b5e6e77b91a1644fceadaafa05f168ddf57ad27c21ebbc7fe",
    "OAUTH_CONFIG_ENCRYPTION_KEY": "411ea8e2bba61a959fbfd946cd54242e75af7e7257657f54ece1ecf421f3280f"
  },
  "observability": {
    "enabled": true
  }
}
